# Copy to .env for development (never commit .env). Servers use infra/.env.example (same names).
# Every variable the app reads is listed here; an empty value means "off" or "not set".

# ── Core ────────────────────────────────────────────────────────────────────────────────
DATABASE_URI=postgres://cv:cv@127.0.0.1:5432/coco_vanille
# Payload signing/encryption secret: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-64-random-chars
# web | studio | all (dev runs both hosts in one process) | worker (npm run worker)
APP_ROLE=all
# Port of `next start` (the Docker image uses 3000 for web, 3001 for studio)
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://admin.localhost:3000
# Host names routed by src/proxy.js
PUBLIC_HOSTS=localhost,cocovanillegranby.com,www.cocovanillegranby.com,staging.cocovanillegranby.com
ADMIN_HOSTS=admin.localhost,admin.cocovanillegranby.com,admin-staging.cocovanillegranby.com
# show = render [[FACT NEEDED]] markers (staging); strict = hide pages with missing facts (production)
PUBLISH_GUARD=show
# Spanish pages stay off until someone serves customers in Spanish (00 §5.2, M10)
ENABLE_ES=false
# Payload CLI looks for tsconfig.json by default; this is a JavaScript project
PAYLOAD_CONFIG_PATH=src/payload.config.js
# Build version shown by /svc/health/ (CI sets GIT_SHA; APP_VERSION is the fallback)
GIT_SHA=
APP_VERSION=

# ── Page refresh and deploys (17 §2, §12.3) ─────────────────────────────────────────────
# Shared secret for POST /svc/revalidate/ (studio, worker and scripts → the public process): openssl rand -hex 32
REVALIDATE_SECRET=
# Where to POST it; empty = ${PUBLIC_ORIGIN}/svc/revalidate/
REVALIDATE_URL=
# Server Actions key shared by every process and colour (blue/green): openssl rand -base64 32. Empty = per build
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Build id for skew protection across colours; CI passes the git SHA. Empty = Next's own
DEPLOYMENT_ID=

# ── Seeds ───────────────────────────────────────────────────────────────────────────────
# true = apply invented demo data (npm run seed:demo, npm run seed:studio-demo); clean = remove it. Never on a server
SEED_DEMO=
# false = skip the dev owner account the seed creates outside production
SEED_DEV_USER=

# ── Payments (Stripe; mock outside production when no key) ──────────────────────────────
# stripe | mock | none: force one adapter (default: stripe with a key, else mock outside production)
PAYMENT_PROVIDER=
# off = never offer the mock « Payer » button, even in development
PAYMENT_MOCK=
# sk_test_… in development and staging
STRIPE_SECRET_KEY=
# pk_test_…, read at run time and handed to the checkout page
STRIPE_PUBLISHABLE_KEY=
# Same key baked in at build time (optional; STRIPE_PUBLISHABLE_KEY wins at run time)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# whsec_… of the webhook endpoint (stripe listen --forward-to localhost:3000/svc/paiement/webhook/)
STRIPE_WEBHOOK_SECRET=
# Stripe.js URL override (default https://js.stripe.com/endive/stripe.js, pinned to the API version)
STRIPE_JS_URL=

# ── Text messages (Twilio; log sender when not set) ─────────────────────────────────────
# twilio | log (default: twilio when the account and token are set, else log)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API key pair instead of the auth token (optional)
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Sender: a Messaging Service SID (preferred) or a number in E.164
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Delivery status webhook (optional)
TWILIO_STATUS_CALLBACK=

# ── Email (Amazon SES in ca-central-1; log sender when not set) ─────────────────────────
# ses | log (SES only with ses: AWS keys alone may belong to backups)
EMAIL_PROVIDER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Temporary credentials only
AWS_SESSION_TOKEN=
AWS_REGION=ca-central-1
# Older name for the region (AWS_REGION wins)
SES_REGION=
# Configuration set for bounce and complaint events (optional)
SES_CONFIGURATION_SET=
# Sender: "Pâtisserie Coco Vanille <commandes@cocovanillegranby.com>" (default) and reply-to
MAIL_FROM=
MAIL_REPLY_TO=
# Development: the log sender also appends every message (JSON lines) to this file
MESSAGE_LOG_FILE=

# ── Worker (npm run worker) ─────────────────────────────────────────────────────────────
# 1 = run every job once and exit (tests, cron checks)
WORKER_ONCE=
# Tick interval in ms (default 5000)
WORKER_INTERVAL_MS=

# ── Coco Studio ─────────────────────────────────────────────────────────────────────────
# Web Push keys (npx web-push generate-vapid-keys): Agence shows them as configured; push sending is not wired yet
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# rank-first report files shown in Agence (default <repo>/reports)
REPORTS_DIR=

# ── Tests and the gate (not read by the app) ────────────────────────────────────────────
# Playwright hosts (default PUBLIC_ORIGIN / ADMIN_ORIGIN)
E2E_PUBLIC_URL=
E2E_ADMIN_URL=
# scripts/gate.mjs: server to read (default PUBLIC_ORIGIN) and basic auth for staging (user:password)
GATE_BASE_URL=
GATE_BASIC_AUTH=
