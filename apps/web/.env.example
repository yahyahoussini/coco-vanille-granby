# Copy to .env (never commit .env)
DATABASE_URI=postgres://cv:cv@127.0.0.1:5432/coco_vanille
PAYLOAD_SECRET=change-me-to-64-random-chars
# web | studio | all (dev runs both hosts in one process)
APP_ROLE=all
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://admin.localhost:3000
PUBLIC_HOSTS=localhost,cocovanillegranby.com,www.cocovanillegranby.com,staging.cocovanillegranby.com
ADMIN_HOSTS=admin.localhost,admin.cocovanillegranby.com,admin-staging.cocovanillegranby.com
# show = render [[FACT NEEDED]] markers (staging); strict = hide pages with missing facts (production)
PUBLISH_GUARD=show
# Spanish pages stay off until someone serves customers in Spanish (00 §5.2, M10)
ENABLE_ES=false
# Payload CLI looks for tsconfig.json by default; this is a JavaScript project
PAYLOAD_CONFIG_PATH=src/payload.config.js
