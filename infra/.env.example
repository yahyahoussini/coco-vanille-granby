# Coco Vanille · environment file for one environment on the VPS.
# Copy to /opt/coco/<env>/.env (production or staging), chmod 600, owner deploy. Never commit it.
# Docker Compose reads it twice: for ${…} substitution in docker-compose.yml, and as env_file
# for every app container. The host scripts (deploy, backup, restore-test) read it too.
# Secrets: generate with `openssl rand -hex 32` (hex only: no URL escaping needed).
# Staging gets its own file with sandbox/test keys; values marked (staging) differ there.

# ── Environment and image ─────────────────────────────────────────────────────────────
# production | staging. Staging: basic auth + noindex in nginx, test keys, no IndexNow.
APP_ENV=production
# Registry path of the image built by CI (tags = git SHA). deploy.sh sets the tags in state.env.
IMAGE=ghcr.io/yahyahoussini/coco-vanille-granby
# web | studio | worker | all. Compose sets it per service; this value only applies to one-off
# `docker compose run` commands. `all` (both hosts in one process) is for dev and CI only.
APP_ROLE=web
# Host ports nginx proxies to (127.0.0.1 only). Production 3001/3002 (blue), 3011/3012 (green);
# (staging) 3101/3102 and 3111/3112.
WEB_BLUE_PORT=3001
STUDIO_BLUE_PORT=3002
WEB_GREEN_PORT=3011
STUDIO_GREEN_PORT=3012
# Payload uploads on the host, bind-mounted at /app/media; nginx serves /media/ from here.
MEDIA_DIR=/opt/coco/production/media
# Server clock for logs and cron-like jobs (the app formats dates in America/Toronto itself).
TZ=America/Toronto

# ── Postgres (container "db", private network only) ──────────────────────────────────
POSTGRES_USER=coco
# openssl rand -hex 24. Compose builds DATABASE_URI from these three values.
POSTGRES_PASSWORD=
POSTGRES_DB=coco

# ── Application ───────────────────────────────────────────────────────────────────────
# Payload signing/encryption secret: openssl rand -hex 32. One per environment, never reused.
PAYLOAD_SECRET=
# Canonical origins. (staging) https://staging.cocovanillegranby.com and https://admin-staging.cocovanillegranby.com
PUBLIC_ORIGIN=https://cocovanillegranby.com
ADMIN_ORIGIN=https://admin.cocovanillegranby.com
# Host names routed by src/proxy.js. (staging) staging.cocovanillegranby.com / admin-staging.cocovanillegranby.com
PUBLIC_HOSTS=cocovanillegranby.com,www.cocovanillegranby.com
ADMIN_HOSTS=admin.cocovanillegranby.com
# strict = pages that still hold a [[FACT NEEDED]] marker are not published (production).
# show = markers render, pages stay noindex (staging, for review).
PUBLISH_GUARD=strict
# Spanish pages stay off until someone serves customers in Spanish (00 §5.2, M10).
ENABLE_ES=false
# Demo catalogue/prices from src/seed/demo.js, labelled demo. Never true outside a local demo.
SEED_DEMO=false
# The seed's dev owner account is skipped in production builds; keep false on servers.
SEED_DEV_USER=false
# Shared secret for POST /svc/revalidate (studio and worker → live public process, 17 §12.3).
REVALIDATE_SECRET=
# Server Actions key shared by every process and colour: openssl rand -base64 32 (17 §2).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Stripe (payments, deposits) ───────────────────────────────────────────────────────
# (staging) sk_test_… / pk_test_… keys from the Stripe test mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint registered in the Stripe dashboard (whsec_…).
STRIPE_WEBHOOK_SECRET=

# ── Twilio (SMS: order confirmations, owner alerts) ───────────────────────────────────
# (staging) Twilio test credentials: no real SMS leaves.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: a Messaging Service SID (preferred) or a Twilio number in E.164 (+1…).
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# ── Amazon SES (transactional email, ca-central-1, never SMTP from the VPS: 17 §9) ────
SES_REGION=ca-central-1
# IAM user limited to ses:SendEmail / ses:SendRawEmail. (staging) SES sandbox or a mail sink.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional configuration set for bounce/complaint events.
SES_CONFIGURATION_SET=
# Verified sender identity on the domain (MAIL FROM on envoi.cocovanillegranby.com, 17 §9.3).
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── Web Push for Coco Studio (VAPID) ──────────────────────────────────────────────────
# npx web-push generate-vapid-keys. One pair per environment; changing it drops subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto: an address the agency reads.
VAPID_SUBJECT=

# ── Search and monitoring ─────────────────────────────────────────────────────────────
# IndexNow key (also served as /<key>.txt). (staging) leave empty: staging never pings.
INDEXNOW_KEY=
# Sentry DSN, PII scrubbed in the app (17 §8.2). Empty = off.
SENTRY_DSN=
# Healthchecks-style ping URLs (dead-man switches). Empty = no ping.
HEARTBEAT_BACKUP_URL=
HEARTBEAT_RESTORE_TEST_URL=

# ── Host scripts only (backup.sh, restore-test.sh, deploy.sh) — no secrets here ────────
# Public host names deploy.sh uses for health checks and the sitemap warm-up.
PUBLIC_HOST=cocovanillegranby.com
ADMIN_HOST=admin.cocovanillegranby.com
# rclone remotes (configured in ~deploy/.config/rclone/rclone.conf), space-separated:
# two buckets in Québec at two providers (17 §7.4). (staging) leave empty: dumps stay local.
BACKUP_REMOTES=
# age public keys, one per line; the private key stays offline (17 §8.1 #8).
AGE_RECIPIENTS_FILE=/opt/coco/age-recipients.txt
# Retention: daily dumps kept, monthly (1st of the month) dumps kept, local copies kept.
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_LOCAL=7
# age private key file for the monthly restore test, mounted from offline storage when it runs.
AGE_IDENTITY_FILE=
