# Monthly restore test of the newest local dump into a scratch container (%i = production | staging).
[Unit]
Description=Coco Vanille restore test (%i)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
ExecStart=/usr/bin/bash /opt/coco/%i/infra/scripts/restore-test.sh %i
Nice=10
